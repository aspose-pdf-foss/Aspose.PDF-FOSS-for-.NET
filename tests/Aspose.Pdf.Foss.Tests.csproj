<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net48;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" Version="6.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Aspose.Pdf.Foss.csproj" />
  </ItemGroup>

  <!-- net48 mirrors the library's own old-target setup. As a friend assembly the tests already see
       the library's internal copy of the polyfill sources, so only the language-feature generator is added here;
       C# 13 matches the library, and nullable flow warnings are off against the unannotated BCL.
       CS1685: the library shadows RuntimeHelpers on that target (src/Compat) and this friend
       assembly sees both copies. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <!-- The polyfill extension methods live in this namespace; the package adds the global using only where it is referenced. -->
    <Using Include="Polyfills" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <LangVersion>13</LangVersion>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS1685</NoWarn>
  </PropertyGroup>

</Project>
